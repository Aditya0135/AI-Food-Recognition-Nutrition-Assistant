# Copy this file to .env and fill values.
# Do not commit .env to source control.

# Spoonacular API key
SPOONACULAR_API_KEY=

# Hugging Face model repository configuration
HF_MODEL_REPO_ID=
HF_MODEL_FILENAME=best_model.pth
HF_CLASS_NAMES_FILENAME=class_names.json
HF_PRIVATE_REPO=false

# Required only for private Hugging Face repositories
HF_TOKEN=
